      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(darkstore_eta_abs_error_minutes_bucket[15m]))",
          "legendFormat": "{{le}}",
          "refId": "A",
